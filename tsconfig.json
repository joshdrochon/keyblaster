{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": { "@engine/*": ["src/engine/*"], "@game/*": ["src/game/*"], "@content/*": ["src/content/*"] }
  },
  "include": ["src", "tests", "scripts", "api"]
}
