{
  "name": "keyblaster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/trace-check.mjs && vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gauntlet": "node scripts/gauntlet.mjs",
    "gauntlet:loop": "node scripts/gauntlet.mjs --loop",
    "trace-check": "node scripts/trace-check.mjs",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "tickets": "node scripts/tickets.mjs",
    "tickets:check": "node scripts/tickets.mjs --check"
  },
  "dependencies": {
    "@types/node": "^22.20.3",
    "phaser": "^3.80.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@vitest/coverage-v8": "^2.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
