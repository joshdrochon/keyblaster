import { stagePoolFor, retentionPoolFor, DEFAULT_FLIGHT_CONFIG } from "@game/flight/stage.js";
import { createSelectionState, pickNext, EmptyStagePoolError } from "@engine/selection/index.js";
import { createAllowlist } from "@engine/allowlist";
import { STOP_IDS } from "@engine/types";

console.log("stageWordCount =", DEFAULT_FLIGHT_CONFIG.stageWordCount, "contentLang =", DEFAULT_FLIGHT_CONFIG.contentLang);
for (const stop of STOP_IDS) {
  const pool = stagePoolFor(stop);
  console.log(stop.padEnd(8), "pool", String(pool.length).padStart(2), pool.length<=2?JSON.stringify(pool):"");
}
console.log();
// simulate a full stage for each stop, contentLang en
for (const lang of ["en","es","hi"] as const) {
 console.log("=== contentLang:", lang, "===");
 for (const stop of STOP_IDS) {
  const idx = STOP_IDS.indexOf(stop);
  const pool = stagePoolFor(stop);
  const retention = retentionPoolFor(STOP_IDS.slice(1, Math.max(1, idx)) as any);
  let st;
  try {
    const al = createAllowlist({ lang, words: [...pool, ...retention] });
    st = createSelectionState({ stage: idx, stagePool: pool, retentionPool: retention, book: {}, allowlist: al });
  } catch (e:any) { console.log(" ", stop.padEnd(8), "THROWS", e.name, "-", e.message); continue; }
  const counts = new Map<string,number>(); let nopick = 0;
  let s = st;
  for (let i=0;i<58;i++){
    const o = pickNext(s, { live: [], nowMs: i*1000 } as any);
    if (o.kind === "none") { nopick++; s = o.state; continue; }
    counts.set(o.word.text, (counts.get(o.word.text)??0)+1);
    s = o.state;
  }
  const mx = Math.max(...counts.values());
  console.log(" ", stop.padEnd(8), "cleaned", String(s.stagePool.length).padStart(2), "distinct served", String(counts.size).padStart(2), "max repeats", mx, "no-pick", nopick);
 }
}
// missing bundle / empty pool
try { createSelectionState({ stage: 3, stagePool: [], retentionPool: [] }); }
catch(e:any){ console.log("\nempty pool ->", e.name, ":", e.message); }
